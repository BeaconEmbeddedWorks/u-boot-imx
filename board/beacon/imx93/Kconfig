if TARGET_IMX93_BEACON

config SYS_BOARD
	default "imx93"

config SYS_VENDOR
	default "beacon"

config SYS_CONFIG_NAME
	default "imx93_beacon"

choice
	prompt "Select method to choose LPDDR4x timing for TARGET_IMX93_BEACON"
	default BEACON_IMX93_LPDDR4X_TIMING_BY_NAME

config BEACON_IMX93_LPDDR4X_TIMING_BY_NAME
	bool "Using BEACON_IMX93_LPDDR4X_TIMING_FILENAME for LPDDR4x Timing selection"
	help
	  Select the LPDDR4x timing based on specified filename

config BEACON_IMX93_LPDDR4X_TIMING_BY_BOARD_ID
	bool "Using Beacon HW Board ID for LPDDR4x Timing selection"
	help
	  Select the LPDDR4x timing based on Board ID

config BEACON_IMX93_LPDDR4X_TIMING_BY_EEPROM
	bool "Using Beacon EEPROM contents for LPDDR4x Timing selection"
	help
	  Select the LPDDR4x timing based on contents of EEPROM on SOM

endchoice

config BEACON_IMX93_LPDDR4X_TIMING_FILENAME
	string "Specify the LPDDR4x Timing Filename"
    depends on BEACON_IMX93_LPDDR4X_TIMING_BY_NAME
	default "lpddr4x_1gbyte_timing"
	help
	  Name of the timing file to use when BEACON_IMX93_LPDDR4X_TIMING_BY_NAME is used.


endif
